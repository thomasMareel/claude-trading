# Copie ce fichier en .env et remplis-le. Le .env n'est JAMAIS commite.
# Mode d'emploi pas a pas : docs/cles-api.md

# --- Cle API Claude : le trader ---
# Cree sur https://console.anthropic.com  (compte API, distinct de l'abonnement Claude)
ANTHROPIC_API_KEY=

# --- Alertes sur ton telephone (facultatif mais vivement conseille) ---
# Application ntfy (Android / iPhone), abonne-toi a un sujet secret, colle-le ici.
# Exemple : NTFY_TOPIC=crypto-claude-7f3a9c2e1b
NTFY_TOPIC=

# --- Cles Binance : INUTILES en paper trading, uniquement pour le reel ---
# Sur binance.com > API Management :
#  - Coche UNIQUEMENT "Enable Reading" et "Enable Spot & Margin Trading"
#  - NE COCHE PAS "Enable Withdrawals"
#  - Restreins l'acces a ton adresse IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet Binance, pour roder le chemin des ordres reels sans argent.
# Cles separees : https://testnet.binance.vision (connexion GitHub)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
