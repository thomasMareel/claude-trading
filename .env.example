# Copie ce fichier en .env et remplis-le. Le .env n'est JAMAIS commite.

# --- Cle API Claude (pour le cerveau LLM) ---
ANTHROPIC_API_KEY=

# --- Cles Binance ---
# IMPORTANT : cree ces cles toi-meme sur binance.com > API Management.
#  - Coche UNIQUEMENT "Enable Spot & Margin Trading"
#  - NE COCHE PAS "Enable Withdrawals"
#  - Restreins l'acces a ton adresse IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet Binance (recommande pour les premiers essais en mode live simule).
# Cles separees a creer sur https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
